# Copia este ficheiro para .env.local e preenche os valores.
# NUNCA coloques valores reais aqui nem no GitHub. Em produção, usa as
# variáveis de ambiente da Vercel (Project → Settings → Environment Variables).

NEXT_PUBLIC_SITE_URL=https://bilonai.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (Resend)
RESEND_API_KEY=

# IA (Gemini) e varredura de anúncios (Apify)
GEMINI_API_KEY=
APIFY_TOKEN=

# Google Drive (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agents.bilonai.com/api/auth/google/callback

# Segurança interna
ENCRYPTION_KEY=
WORKER_SECRET=

# Cobrança (Lemon Squeezy) — ver docs/BILLING.md
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=1
LS_VARIANT_ALPHA=
LS_VARIANT_APEX=
LS_VARIANT_SYNDICATE=

# Travões de custo (ver docs/PRICING.md)
APIFY_MONTHLY_BUDGET_USD=4.5
MAX_TRIALS_PER_MONTH=5
